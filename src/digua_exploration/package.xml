<?xml version="1.0"?>
<package format="3">
  <name>digua_exploration</name>
  <version>0.0.1</version>
  <description>Frontier exploration package for Digua robot autonomous mapping.</description>

  <maintainer email="sunrise@example.com">sunrise</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
